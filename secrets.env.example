# Copy to secrets.env beside docker-compose.yml. Gitignored and dockerignored.
#
# NOT .env: docker compose reads .env for its own variable substitution and would try to
# expand the `$` signs in a bcrypt hash (F-58). Compose passes this file through with
# `format: raw`, so nothing here is escaped.

# The admin account. It unlocks one thing: the data bundle at /api/download/data.
# Generate the hash:
#   node -e "console.log(require('./frontend/node_modules/bcryptjs').hashSync(process.argv[1],12))" "your-password"
ADMIN_USERNAME=owner
ADMIN_PASSWORD_HASH=

# At least 32 characters:
#   node -e "console.log(require('node:crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=
