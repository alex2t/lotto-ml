# Where drawpick.py's artifacts live. In Docker this is the read-only mount at /app/data.
DATA_DIR=../data

# The one admin account. Generate the hash with:
#   node -e "console.log(require('bcryptjs').hashSync(process.argv[1], 12))" "your-password"
ADMIN_USERNAME=owner
ADMIN_PASSWORD_HASH=

# At least 32 characters. Generate with:
#   node -e "console.log(require('node:crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=
