FROM python:3.11-slim

# Set environment variables
ENV PYTHONUNBUFFERED=1 \
    PYTHONDONTWRITEBYTECODE=1 \
    PYTHONPATH=/app

WORKDIR /app

# Create non-root user and group. The uid must own the host's data/ directory, which the
# bind mount puts in place of the image's own - set UID/GID at build time to match the VPS.
ARG UID=1000
ARG GID=1000
RUN groupadd -g ${GID} lotto && \
    useradd -u ${UID} -g ${GID} -s /bin/bash -m lotto

# Install minimal engine dependencies
COPY requirements-engine.txt .
RUN pip install --no-cache-dir -r requirements-engine.txt

# Copy analysis code and orchestrator
COPY drawpick.py .
# The rebuild receiver runs drawpick.py in this same image - it is the only container with
# Python, the analysis code and write access to data/ (docker-compose.prod.yml).
COPY rebuild_webhook.py .
COPY lotto_analysis/ lotto_analysis/
COPY analysis/bonus_analysis.py analysis/bonus_analysis.py

# Create analysis output directory and set ownership
RUN mkdir -p /app/data/analysis && chown -R lotto:lotto /app

USER lotto

ENTRYPOINT ["python", "drawpick.py"]
