# Copy to .env beside docker-compose.yml. Gitignored and dockerignored - never committed.
# Compose passes this file to nextjs-web with `format: raw`, so a bcrypt hash's `$` signs
# are safe here and must NOT be escaped (F-58).

# The admin account. It unlocks one thing: the data bundle at /api/download/data.
# Generate the hash:
#   node -e "console.log(require('./frontend/node_modules/bcryptjs').hashSync(process.argv[1],12))" "your-password"
ADMIN_USERNAME=owner
ADMIN_PASSWORD_HASH=

# At least 32 characters:
#   node -e "console.log(require('node:crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=

# The uid/gid the containers run as; must own ./data (F-45).
UID=1000
GID=1000
